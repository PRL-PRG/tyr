
===== Native code =====

scale_by: ([DBL, any_sexp] -> DBL<> with {  }) & ([DBL1, any_sexp] -> DBL1<> with {  })

with_unit: ∀'a. [any_sexp, any_sexp & 'a] -> <measure> with { unit: <...> | any_sexp & 'a, any }

is_missing: [c_double] -> c_bool

count_na: [DBL] -> INT1<> with {  }


===== R code =====


===== prelude prelude/base.R =====
C_count_na: (x1: DBL) -> INT1<> with {  }

C_scale_by: ((x1: DBL, x2: any) -> DBL<> with {  }) & ((x1: DBL1, x2: any) ->
            DBL1<> with {  })

C_with_unit: (x1: any, x2: 'I72 & (<...> | null | sym)) ->
             <measure> with { unit: <...> | any_sexp & 'I72, any }


===== packages/mixpkg/R/z_helpers.R =====
format_value: (((x: <@round, ...>) -> empty) & ((x: dbl<~@round, ...>) -> CHR1<>))<>

bad_total: ((x: <@sum, ...>) -> empty)<>

report: ((x: <@sum, ...>) -> empty)<>


===== packages/mixpkg/R/generics.R =====
describe: ((x: ~<@describe, ...>, ...: any) -> any)<>

describe.measure: (((x: dbl with { unit: any, any }, ...: any) -> CHR<>) &
 ((x: dbl with { unit: vec1, any }, ...: any) -> CHR1<>))<>

describe.default: (((x: <@round, ...>, ...: any) -> empty) & ((x: dbl<~@round, ...> |
 <@round, ...>, ...: any) -> CHR1<>))<>


===== packages/mixpkg/R/natives.R =====
scale_by: (((x: <@as.double, ...>, k: any?) | (x: null |
 vec<~@as.double, ...>, k: any?) -> DBL<> with {  }) &
 ((x: vec1<~@as.double, ...>, k: any?) -> DBL1<> with {  }))<>

measure: ∀'a. ((x: null | (vec<~@as.double, ...> | <@as.double, ...>), unit: ('a &
 (<...> | null | sym))?) -> <measure> with { unit: <...> | any_sexp &
 'a, any })<>

count_missing: ((x: <@as.double, ...>) | (x: null | vec<~@as.double, ...>) ->
 INT1<> with {  })<>

