text: "I will check two signatures."
tool call toolu_A: check_type {"signature":"(x: dbl) -> dbl"}
tool call toolu_B: check_type {"signature":"(x: "}
next request:
{
  "model": "claude-x",
  "max_tokens": 1024,
  "cache_control": { "type": "ephemeral" },
  "system": [
    {
      "type": "text",
      "text": "You type R functions.",
      "cache_control": { "type": "ephemeral" }
    }
  ],
  "messages": [
    { "role": "user", "content": "Type f." },
    {
      "role": "assistant",
      "content": [
        {
          "type": "thinking",
          "thinking": "Let me check.",
          "signature": "sig=="
        },
        { "type": "text", "text": "I will check two signatures." },
        {
          "type": "tool_use",
          "id": "toolu_A",
          "name": "check_type",
          "input": { "signature": "(x: dbl) -> dbl" }
        },
        {
          "type": "tool_use",
          "id": "toolu_B",
          "name": "check_type",
          "input": { "signature": "(x: " }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_A",
          "content": "accepted",
          "is_error": false
        },
        {
          "type": "tool_result",
          "tool_use_id": "toolu_B",
          "content": "parse error",
          "is_error": true
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "check_type",
      "description": "Check a signature against the definition.",
      "input_schema": {
        "type": "object",
        "properties": { "signature": { "type": "string" } },
        "required": [ "signature" ]
      }
    }
  ]
}
with an effort and a summary of the thinking (the fields before "messages"):
thinking: {"type":"adaptive","display":"summarized"}
output_config: {"effort":"high"}

===== OpenAI: reasoning_content, null fields, arguments as a string =====
stop: tool_use, tokens: 50 in, 30 out, cache: 150 read, 0 written
text: ""
tool call call_1: check_type {"signature":"(x: dbl) -> dbl"}
tool call abc123XYZ: check_type "{not json"
next request (max_tokens):
{
  "model": "glm",
  "messages": [
    { "role": "system", "content": "You type R functions." },
    { "role": "user", "content": "Type f." },
    {
      "role": "assistant",
      "reasoning_content": "The argument is numeric.",
      "tool_calls": [
        {
          "id": "call_1",
          "type": "function",
          "function": {
            "name": "check_type",
            "arguments": "{\"signature\": \"(x: dbl) -> dbl\"}"
          }
        },
        {
          "id": "abc123XYZ",
          "type": "function",
          "function": { "name": "check_type", "arguments": "{not json" }
        }
      ]
    },
    { "role": "tool", "tool_call_id": "call_1", "content": "accepted" },
    {
      "role": "tool",
      "tool_call_id": "abc123XYZ",
      "content": "Error: parse error"
    }
  ],
  "max_tokens": 1024,
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "check_type",
        "description": "Check a signature against the definition.",
        "parameters": {
          "type": "object",
          "properties": { "signature": { "type": "string" } },
          "required": [ "signature" ]
        }
      }
    }
  ],
  "temperature": 0.0,
  "seed": 7
}
