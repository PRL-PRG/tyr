checked: ∀`a. (((n: (DBL | INT)<~@"+", . | `a>) -> (DBL | INT)<~@"+", . | `a>) &
 ((n: DBL1<~@"+", . | `a> | INT1<~@"+", . | `a>) -> DBL1<~@"+", . | `a>) &
 ((n: DBL<@"+", ...> | INT<@"+", ...>) -> (DBL | INT)<difftime> | LGL<> |
 dbl<Date, ...> | <POSIXt, ...>) & ((n: ~(DBL | INT)) -> empty))<>

