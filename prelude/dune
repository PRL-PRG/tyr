; The base R signatures tyr type-checks packages against live with Rsem.
; Copying them here makes them reachable from the build tree, and installs them
; so that the image (and anyone with `tyr` in their switch) can point
; --prelude at them.
(copy_files
 (files %{project_root}/Rsem/sigs/*.R))

(install
 (section share)
 (package tyr)
 (files base.R))
